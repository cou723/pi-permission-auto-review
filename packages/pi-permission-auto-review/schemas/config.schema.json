{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mzwing/pi-packages/master/packages/pi-permission-auto-review/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "preset": {
      "enum": ["codex", "claude-code"],
      "type": "string",
      "default": "codex"
    },
    "standalonePolicy": {
      "type": "string",
      "minLength": 1,
      "description": "codex の既定の分類・閾値を使わない独立ポリシー。claude-code プリセットや autoMode と混在不可。"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
      "type": "string"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000,
      "default": 90000
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "default": 2
    },
    "attemptTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "followUpReviews": {
      "enum": ["auto", "always", "off"],
      "type": "string",
      "default": "auto"
    },
    "fallback": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "reasoning": {
              "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "cooldownMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": ["provider", "model", "reasoning", "timeoutMs", "cooldownMs"],
          "additionalProperties": false
        }
      ]
    },
    "autoMode": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": ["$defaults"]
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": ["$defaults"]
        },
        "soft_deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": ["$defaults"]
        },
        "hard_deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": ["$defaults"]
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": [],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["standalonePolicy"]
      },
      "then": {
        "properties": {
          "preset": {
            "const": "codex"
          },
          "autoMode": {
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
